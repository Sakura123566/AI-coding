# ---------- 服务 ----------
# development 可直接运行；production 会强制校验 AUTH_SECRET 与 CORS_ORIGINS
ENVIRONMENT=development
# 后端监听地址与端口（本机开发用 127.0.0.1，容器内使用 0.0.0.0）
HOST=127.0.0.1
PORT=8000
# 允许的前端来源，多个用逗号分隔；开发期可用 *，production 必须写准确 HTTPS 域名
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 论文来源 ----------
# auto（按顺序自动降级） / arxiv / openalex / semanticscholar / crossref / mock / mcp
PAPER_SOURCE=auto
# PAPER_SOURCE=auto 时的尝试顺序，逗号分隔，第一个非空结果即返回
# openalex：免费、无需密钥、限流宽松，arXiv 返回 406 被限流时它是最靠谱的兜底
PAPER_SOURCE_ORDER=mcp,arxiv,openalex,crossref
# 单次检索超时（秒）
HTTP_TIMEOUT=15
# 默认/最大返回篇数
DEFAULT_LIMIT=10
MAX_LIMIT=30

# ---------- 论文检索 MCP（PAPER_SOURCE=mcp 时生效）----------
# 两种形态，填哪个就走哪个：
#   A. 网址端点型（托管 MCP，把 URL 填进工具那种）→ 填 MCP_URL
#   B. 本地命令型（npx / python 启动）              → 填 MCP_COMMAND
MCP_TRANSPORT=auto        # auto | http | sse | stdio
MCP_URL=                  # 例：https://mcp.xxx.com/xxx/mcp   或 .../sse（带 sse 会自动走 SSE）
MCP_COMMAND=              # 例：npx -y @modelcontextprotocol/server-arxiv
# 需要鉴权的端点：二选一即可
MCP_AUTH_TOKEN=           # 会以 Authorization: Bearer xxx 发出
MCP_HEADERS=              # 自定义请求头，JSON，例：{"X-Api-Key":"abc"}
# 指定工具名；留空则自动挑名字/描述里带 search|paper|arxiv|论文 的工具
# 不知道叫什么就跑：python scripts/verify_source.py --source mcp --url <端点> --list-tools
MCP_TOOL_NAME=
# MCP 单次调用超时（秒）
MCP_TIMEOUT=45

# ---------- 结果缓存 ----------
# 同一主题重复请求直接返回上次结果，避免演示时重复检索 + 重复烧模型调用
# 只有"有论文且报告成功"的结果才缓存；空结果、报错、报告失败都不缓存，刷新即重试
CACHE_ENABLED=true
CACHE_TTL=600                # 缓存有效期（秒）
CACHE_MAX_ENTRIES=64         # 最多缓存多少条，超出淘汰最久未用的

# ---------- 日志 ----------
# 走 stderr，格式：时间 级别 [请求ID] 消息
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# openai / mock。mock 不联网，用本地样例报告，仅供联调（页面上会标注"样例"）
# 换成真实模型需要三样：LLM_PROVIDER=openai + LLM_API_KEY + （国内中转站还要改 LLM_BASE_URL）
LLM_PROVIDER=mock
# OpenAI 兼容端点，例如 https://api.openai.com/v1 或任意中转站
LLM_BASE_URL=https://api.openai.com/v1
# 密钥只放后端环境变量，绝不进前端、绝不进仓库
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=90
# 你的端点是否支持 response_format=json_object（不支持就设 false）
LLM_JSON_MODE=true

# ---------- 用户系统（注册登录 / 对话 / 记忆 / 画像）----------
# SQLite 文件位置，留空用 backend/data/app.db（首次启动自动建库建表）
DB_PATH=
# JWT 签名密钥：**部署到公网前一定要改成随机字符串**，否则别人能伪造登录态
AUTH_SECRET=research-navigator-dev-secret
AUTH_TOKEN_TTL=604800          # token 有效期（秒），默认 7 天
MIN_PASSWORD_LEN=6

# 对话与记忆
CHAT_WINDOW=6                  # 短期上下文保留几轮
MEMORY_TOP_K=8                 # 每轮最多注入多少条长期记忆
MEMORY_HALF_LIFE_DAYS=35       # 记忆新鲜度半衰期（天）
PROFILE_MIN_SAMPLE=5           # 少于这个样本量，画像判定为"数据不足"

# 关键词 / 知识图谱对外暴露的下限（过滤噪声用）
KG_MIN_TIMES=2
KG_MIN_WEIGHT=0.2
KG_DEFAULT_LIMIT=200
