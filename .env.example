# ---------- 服务 ----------
# development 可直接运行；production 会强制校验 AUTH_SECRET 与 CORS_ORIGINS
ENVIRONMENT=development
# 后端监听地址与端口（本机开发用 127.0.0.1，容器内使用 0.0.0.0）
HOST=127.0.0.1
PORT=8000
# 允许的前端来源，多个用逗号分隔；开发期可用 *，production 必须写准确 HTTPS 域名
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 论文来源 ----------
# auto（按顺序自动降级） / arxiv / openalex / semanticscholar / crossref / mock / mcp
PAPER_SOURCE=auto
# PAPER_SOURCE=auto 时问哪些源，逗号分隔
# 注意：MCP_TOOL_NAME=search_openalex 时，mcp 和 openalex 打的是同一个 OpenAlex API——
# 两个都留在列表里等于每次检索把 OpenAlex 打两遍，是限流的放大器。
# 本地 MCP 只是包了同一个 API 的话，建议去掉 mcp：PAPER_SOURCE_ORDER=arxiv,crossref,openalex
PAPER_SOURCE_ORDER=arxiv,crossref,openalex
# 单次检索超时（秒）
HTTP_TIMEOUT=15
# OpenAlex / Crossref 建议填真实联系邮箱，用于礼貌池和限流沟通
SCHOLARLY_CONTACT_EMAIL=
# 429/406 后暂停该来源，避免连续重试把限流拖长；0 表示关闭
SOURCE_COOLDOWN_SECONDS=300
# 默认/最大返回篇数
DEFAULT_LIMIT=10
MAX_LIMIT=30

# ---------- arXiv 统一出口：限速 / 重试 / 冷却 / 熔断 ----------
# 相邻两次 arXiv 请求的最小间隔（秒）。官方建议 3 秒，别调小
ARXIV_MIN_INTERVAL_SECONDS=3
# 单次请求最多重试几次（不含首次）；持续失败时按此上限停止，不无限重试
ARXIV_MAX_RETRIES=3
# 退避：等待 = min(基数 × 2^重试次数 + 抖动, 上限)，服务端给了 Retry-After 就听服务端的
ARXIV_BACKOFF_BASE_SECONDS=2
ARXIV_MAX_BACKOFF_SECONDS=60
ARXIV_JITTER_RATIO=0.2
# 429/406 后整条出口进入冷却的时长（秒）
ARXIV_COOLDOWN_SECONDS=300
# 连续失败几次后熔断、熔断后多久开始半开探测
ARXIV_CIRCUIT_THRESHOLD=3
ARXIV_CIRCUIT_COOLDOWN_SECONDS=120
# 能容忍的最长限速等待（秒），超过就直接失败让上层换数据源；0 表示愿意一直等
ARXIV_RATE_LIMIT_MAX_WAIT=0
# 限速器后端：sqlite=跨进程共享（MCP 子进程也遵守，默认）；memory=仅单进程内生效
ARXIV_RATE_LIMIT_BACKEND=sqlite

# ---------- 多源调度（PAPER_SOURCE=auto 时生效）----------
# parallel=并行问所有源，合并去重、字段互补（默认，摘要/DOI 更全）
# fallback=按顺序串行问，第一个非空结果即返回（改造前的老行为）
PAPER_SEARCH_MODE=parallel
# 并行检索总预算：超过就放弃还没回来的源（秒）
PAPER_SEARCH_BUDGET_SECONDS=30
# 已经有源返回结果后，最多再等这么久等剩下的源（秒）。
# 没有它的话，一个卡住的源会把每次检索都拖到"单源超时"为止
PAPER_SEARCH_GRACE_SECONDS=4
# 单个源最多等多久（秒）。arXiv 从被墙的网络里 SSL 握手会一直挂着，别设太大
PAPER_PROVIDER_TIMEOUT_SECONDS=12
# 多源合并后仍有论文缺摘要时，用 DOI 去 OpenAlex 批量补（一次请求最多 50 个 DOI）
ABSTRACT_BACKFILL_ENABLED=true
ABSTRACT_BACKFILL_MAX=20

# ---------- 通用上游保护（OpenAlex / Crossref / Semantic Scholar）----------
# arXiv 有上面那套专属保护；这几个源是裸请求，429 就直接失败，所以也要保护
# 单次请求最多重试几次（不含首次）
HTTP_MAX_RETRIES=2
# 退避：等待 = min(基数 × 2^重试次数 + 抖动, 上限)；服务端给了 Retry-After 就听服务端的
HTTP_BACKOFF_BASE_SECONDS=1.5
HTTP_MAX_BACKOFF_SECONDS=20
HTTP_JITTER_RATIO=0.3
# 连续失败几次后熔断、熔断后多久开始半开探测
SOURCE_CIRCUIT_THRESHOLD=3
SOURCE_CIRCUIT_COOLDOWN_SECONDS=120
# 限速状态后端：memory=单进程（默认）；sqlite=跨进程共享（MCP 子进程也遵守）
SOURCE_RATE_LIMIT_BACKEND=memory

# ---------- 论文搜索缓存（SQLite）----------
PAPER_CACHE_ENABLED=true
# 缓存库位置，留空用 backend/data/paper_cache.db
CACHE_DB_PATH=
PAPER_CACHE_TTL_SEARCH=86400      # 搜索结果 24 小时
PAPER_CACHE_TTL_PAPER=604800      # 论文元数据 7 天
PAPER_CACHE_MAX_ENTRIES=2000      # 超出淘汰最久未用的，防止无限增长
# 数据源全挂时，是否允许返回过期缓存兜底（会明确标记数据可能过期）
PAPER_CACHE_STALE_FALLBACK=true
PAPER_CACHE_STALE_TTL=604800

# ---------- 论文检索 MCP（PAPER_SOURCE=mcp 时生效）----------
# 两种形态，填哪个就走哪个：
#   A. 网址端点型（托管 MCP，把 URL 填进工具那种）→ 填 MCP_URL
#   B. 本地命令型（npx / python 启动）              → 填 MCP_COMMAND
MCP_TRANSPORT=auto        # auto | http | sse | stdio
MCP_URL=                  # 例：https://mcp.xxx.com/xxx/mcp   或 .../sse（带 sse 会自动走 SSE）
MCP_COMMAND=              # 例：npx -y @modelcontextprotocol/server-arxiv
# 需要鉴权的端点：二选一即可
MCP_AUTH_TOKEN=           # 会以 Authorization: Bearer xxx 发出
MCP_HEADERS=              # 自定义请求头，JSON，例：{"X-Api-Key":"abc"}
# 指定工具名；留空则自动挑名字/描述里带 search|paper|arxiv|论文 的工具
# 不知道叫什么就跑：python scripts/verify_source.py --source mcp --url <端点> --list-tools
MCP_TOOL_NAME=
# MCP 单次调用超时（秒）
MCP_TIMEOUT=45

# ---------- 结果缓存 ----------
# 同一主题重复请求直接返回上次结果，避免演示时重复检索 + 重复烧模型调用
# 只有"有论文且报告成功"的结果才缓存；空结果、报错、报告失败都不缓存，刷新即重试
CACHE_ENABLED=true
CACHE_TTL=600                # 缓存有效期（秒）
CACHE_MAX_ENTRIES=64         # 最多缓存多少条，超出淘汰最久未用的

# ---------- 日志 ----------
# 走 stderr，格式：时间 级别 [请求ID] 消息
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# openai / mock。mock 不联网，用本地样例报告，仅供联调（页面上会标注"样例"）
# 换成真实模型需要三样：LLM_PROVIDER=openai + LLM_API_KEY + （国内中转站还要改 LLM_BASE_URL）
LLM_PROVIDER=mock
# OpenAI 兼容端点，例如 https://api.openai.com/v1 或任意中转站
LLM_BASE_URL=https://api.openai.com/v1
# 密钥只放后端环境变量，绝不进前端、绝不进仓库
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=90
# 你的端点是否支持 response_format=json_object（不支持就设 false）
LLM_JSON_MODE=true

# ---------- 用户系统（注册登录 / 对话 / 记忆 / 画像）----------
# SQLite 文件位置，留空用 backend/data/app.db（首次启动自动建库建表）
DB_PATH=
# JWT 签名密钥：**部署到公网前一定要改成随机字符串**，否则别人能伪造登录态
AUTH_SECRET=research-navigator-dev-secret
AUTH_TOKEN_TTL=604800          # token 有效期（秒），默认 7 天
MIN_PASSWORD_LEN=6

# 对话与记忆
CHAT_WINDOW=6                  # 短期上下文保留几轮
MEMORY_TOP_K=8                 # 每轮最多注入多少条长期记忆
MEMORY_HALF_LIFE_DAYS=35       # 记忆新鲜度半衰期（天）
PROFILE_MIN_SAMPLE=5           # 少于这个样本量，画像判定为"数据不足"

# 关键词 / 知识图谱对外暴露的下限（过滤噪声用）
KG_MIN_TIMES=2
KG_MIN_WEIGHT=0.2
KG_DEFAULT_LIMIT=200

# 周报使用的本地时区偏移（中国为 8）
REPORT_TIMEZONE_OFFSET_HOURS=8

# 论文标题与摘要中文化
ABSTRACT_TRANSLATION_ENABLED=true
ABSTRACT_TRANSLATION_MAX_PAPERS=12
ABSTRACT_TRANSLATION_BATCH_SIZE=6
ABSTRACT_SUMMARY_MAX_CHARS=180
