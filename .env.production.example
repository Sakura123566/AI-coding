# 复制为平台环境变量；不要把真实文件提交到仓库。
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://your-frontend.example.com
AUTH_SECRET=replace-with-a-long-random-secret
DB_PATH=/app/backend/data/app.db

PAPER_SOURCE=auto
PAPER_SOURCE_ORDER=arxiv,openalex,crossref
HTTP_TIMEOUT=15
DEFAULT_LIMIT=10
MAX_LIMIT=30

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-in-platform-secret-store
LLM_MODEL=deepseek-chat
LLM_JSON_MODE=true
LLM_TIMEOUT=90

CACHE_ENABLED=true
CACHE_TTL=21600
CACHE_MAX_ENTRIES=128
LOG_LEVEL=INFO