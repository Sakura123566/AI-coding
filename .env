# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# ---------- 论文来源 ----------
# mcp 优先：走标准 MCP 协议调用本地论文检索工具（内部转发 arXiv 官方 API）
# 万一 MCP 起不来，自动降级到直连 arxiv，演示不会白屏
PAPER_SOURCE=auto
PAPER_SOURCE_ORDER=mcp,arxiv,semanticscholar,crossref
HTTP_TIMEOUT=15
DEFAULT_LIMIT=10
MAX_LIMIT=30

# ---------- 论文检索 MCP ----------
# 传输方式自动识别：ws://|wss:// → WebSocket；URL 含 sse → SSE；其他 → HTTP
# 例（IntelliConnect MCP Manager）：MCP_URL=ws://127.0.0.1:8080/mcp?token=xxxx
# 配好后把 PAPER_SOURCE 改成 mcp 才会走它
MCP_TRANSPORT=auto
MCP_URL=
MCP_COMMAND={python} scripts/local_paper_mcp_server.py
MCP_AUTH_TOKEN=
MCP_HEADERS=
MCP_TOOL_NAME=search_arxiv
MCP_TIMEOUT=45

# ---------- 大模型（报告生成）----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-bb32c1593c094f1d87ed473898fdb2e4
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=90
LLM_JSON_MODE=true
